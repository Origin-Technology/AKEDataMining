              }
            },
            "stimulusConditionCfg": {
              "stimulusConditionData": [
                {
                  "$type": "Beyond.Gameplay.AI.EnemyCheckInZeroPoise+EnemyCheckInZeroPoiseData, Gameplay.Beyond",
