                }
              ]
            },
            "responseCfg": {
              "responseData": {
                "$type": "Beyond.Gameplay.AI.EnemyResetPoiseResponse+EnemyResetPoiseResponseData, Gameplay.Beyond",
                "tickInterval": 0.1
              }
            }
          }
        ]
      }
    }
  }
}