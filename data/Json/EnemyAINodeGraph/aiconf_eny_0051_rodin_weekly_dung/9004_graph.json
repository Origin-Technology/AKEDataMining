      "canvasGraph": {
        "$type": "NodeCanvas.BehaviourTrees.BehaviourTree, ParadoxNotion"
      },
      "entityMode": "Battle",
      "soundName": "au_eny_find_target",
      "alertRange": 9.0,
      "setWaitTime": false,
      "waitTime": 0.0,
      "useCommonBehavior": false,
      "enterConfrontDis": 3.0,
      "enemySR": {
        "cfg": [
          {
            "finishCount": 1,
            "stimulusCfg": {
              "stimulusData": {
                "$type": "Beyond.Gameplay.AI.EnemyHpChangeStimulus+EnemyHpChangeStimulusData, Gameplay.Beyond",
